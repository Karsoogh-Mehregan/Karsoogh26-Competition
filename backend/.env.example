# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me

DEBUG=True
# 127.0.0.1 is required by the container healthcheck, which probes /healthz locally.
ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origin of the Vite SPA (needed when Host and Origin differ).
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_HOSTS=event.karsooghmehregan.ir,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://event.karsooghmehregan.ir
# Cookies then require HTTPS (SESSION_COOKIE_SECURE / CSRF_COOKIE_SECURE) —
# see core/settings.py.

# Unset in development: SQLite and the local-memory cache are used instead.
# DATABASE_URL=postgres://karsoogh:karsoogh@localhost:5432/karsoogh
# REDIS_URL=redis://localhost:6379/0        # Streams / SSE fan-out
# REDIS_CACHE_URL=redis://localhost:6379/1  # cache

# --- S3 media storage ---
# Leave S3_BUCKET_NAME empty to keep uploads on disk under MEDIA_ROOT (dev, tests).
# Setting it switches question attachments and submissions to S3; the media
# endpoints then redirect to a presigned URL instead of streaming the bytes.
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Required for MinIO / any non-AWS gateway, e.g. https://s3.karsooghmehregan.ir
S3_ENDPOINT=
S3_REGION=us-east-1
# Presigned URL lifetime, seconds.
S3_PRESIGNED_EXPIRE=300
