# Backend container env. Copy to .env.backend.
# Compose interpolates these values, so a literal $ must be written $$.
# Generate a key without $:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me

# drf-spectacular is a dev dependency and is not in the image, so the container
# must run with DEBUG off.
DEBUG=False

# 127.0.0.1 is required by the container healthcheck, which probes /healthz locally.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- S3 media storage ---
# S3_BUCKET_NAME / S3_ACCESS_KEY / S3_SECRET_KEY / S3_ENDPOINT are set by compose
# from the root .env, so the MinIO service and the app cannot drift apart.
S3_REGION=us-east-1
S3_PRESIGNED_EXPIRE=300

# --- HTTPS hardening ---
# Default follows DEBUG (off in dev, on in production). Set all three False for a
# plain-HTTP local run of the container stack: DEBUG is off there, but no TLS
# terminates in front, so https redirects and Secure cookies would break login.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- Bootstrap ---
# The entrypoint creates this superuser on first boot and skips it once the
# username exists; it never rotates the password. Leave the username empty to
# create no superuser at all. Compose interpolates these, so a literal $ is $$.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-me
