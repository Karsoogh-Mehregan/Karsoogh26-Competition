# --- Published ports (host side) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- PostgreSQL ---
POSTGRES_USER=karsoogh
POSTGRES_PASSWORD=changeme
POSTGRES_DB=karsoogh

# --- MinIO (S3-compatible storage) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=karsoogh
MINIO_ROOT_PASSWORD=changeme
S3_BUCKET_NAME=karsoogh-media
APP_S3_ACCESS_KEY=media_app
APP_S3_SECRET_KEY=changeme

# --- Deployed images (CD overrides these per release) ---
FRONTEND_IMAGE=ghcr.io/karsoogh-mehregan/karsoogh26-competition-frontend:latest
BACKEND_IMAGE=ghcr.io/karsoogh-mehregan/karsoogh26-competition-backend:latest
